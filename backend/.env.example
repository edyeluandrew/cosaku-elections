# Database (Neon, Supabase, Render Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Server
PORT=5000
NODE_ENV=production

# JWT — use a strong random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Client URL(s) — comma-separated list of allowed frontend origins
# Example: https://cosaku.vercel.app,http://localhost:5173
CLIENT_URL=https://your-frontend.vercel.app

# Email (Gmail App Password recommended)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password
EMAIL_FROM="COSAKU Votes <youraddress@gmail.com>"

# File Upload
UPLOAD_DIR=src/uploads

# Admin Defaults — created automatically on first boot
DEFAULT_ADMIN_NAME=Admin Name
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeThisStrongPassword!
